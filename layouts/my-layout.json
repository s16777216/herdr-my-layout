{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.14"
  },
  "type": "column",
  "resizable": false,
  "children": [
    {
      "id": "workspace-row",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "border"
      },
      "children": [
        {
          "id": "activity-bar-left",
          "type": "block",
          "content": {
            "mod": "activity-bar-left"
          },
          "size": {
            "px": 44
          },
          "resizable": false,
          "window_drag": true
        },
        {
          "id": "sidebar",
          "type": "column",
          "children": [
            {
              "id": "brand",
              "type": "block",
              "content": {
                "mod": "workspace-chrome"
              },
              "size": {
                "px": 46
              },
              "window_drag": true
            },
            {
              "id": "sidebar-lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "content": {
                    "mod": "workspace-spaces"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                },
                {
                  "id": "agents",
                  "type": "block",
                  "content": {
                    "mod": "workspace-agents"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 90
                }
              ]
            }
          ],
          "size": {
            "px": 240
          },
          "min": 0,
          "max": 480,
          "background": "chrome",
          "resizable": false,
          "hidden": false
        },
        {
          "id": "work",
          "type": "column",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "pierre-tree-files-tab"
              },
              "size": {
                "px": 42
              },
              "window_drag": true
            },
            {
              "id": "work-body",
              "type": "row",
              "children": [
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 41,
                        "position": "top"
                      },
                      "background": "background",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 1,
                        "color": "accent"
                      },
                      "radius": 0,
                      "gap": 0,
                      "lone": true
                    }
                  }
                },
                {
                  "id": "panel",
                  "type": "column",
                  "children": [
                    {
                      "id": "panel-body",
                      "type": "stack",
                      "children": [
                        {
                          "id": "files",
                          "type": "block",
                          "content": {
                            "mod": "pierre-tree-files"
                          }
                        },
                        {
                          "id": "changes",
                          "type": "block",
                          "content": {
                            "mod": "git"
                          }
                        }
                      ],
                      "active": "files"
                    }
                  ],
                  "size": {
                    "px": 320
                  },
                  "min": 240,
                  "max": 900,
                  "hidden": true
                }
              ],
              "padding": 0,
              "gap": 0
            }
          ],
          "resizable": false
        },
        {
          "id": "activity-bar-right",
          "type": "block",
          "content": {
            "mod": "activity-bar-right"
          },
          "size": {
            "px": 44
          },
          "resizable": false,
          "window_drag": true
        }
      ]
    },
    {
      "id": "status",
      "type": "block",
      "content": {
        "mod": "agent-usage"
      },
      "size": {
        "px": 28
      }
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
